# Copy to .env (gitignored) or set these in your service manager. Never commit real values.

# From the WHOOP Developer Dashboard (developer-dashboard.whoop.com).
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Must match a Redirect URL registered on the WHOOP app, and the app's WhoopAPI.redirectURI.
WHOOP_REDIRECT_URI=suppl://whoop/callback

# Optional. If set, requests must send the same value in the x-suppl-key header.
# It ships inside the app, so it only keeps casual traffic out. It is not a secret.
APP_KEY=

# Where to listen. Keep 127.0.0.1 and put Caddy or nginx in front for HTTPS.
HOST=127.0.0.1
PORT=8787

# Only for tests or a staging WHOOP. Defaults to https://api.prod.whoop.com/oauth/oauth2/token
WHOOP_TOKEN_URL=
